{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2yolks",
  "main": "packages/api/src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOW_DEMO_SEED": "false",
    "CANONICAL_ORIGIN": "https://2yolks.com"
  },
  // Abuse limits for sign-in and submissions (Workers rate limiting: free, approximate, per location).
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "2101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_SUBMIT", "namespace_id": "2102", "simple": { "limit": 20, "period": 60 } }
  ],
  "assets": {
    "directory": "./packages/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "2yolks-images" // dedicated recipe-image bucket; created in the CF dashboard 2026-11-03 under the approved image plan
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "2yolks",
      "database_id": "e8eadf5d-a251-4065-8013-810c710ebc40", // provisioned via CF dashboard 2026-11-01, free plan,
      "migrations_dir": "packages/api/migrations"
    }
  ]
}
