{
  "name": "2yolks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @2yolks/web && npm run build -w @2yolks/api",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate:local": "wrangler d1 execute 2yolks --local --file packages/api/migrations/0001_init.sql",
    "deploy": "wrangler deploy",
    "test:routes": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.7",
    "vitest": "^3",
    "wrangler": "^4"
  }
}