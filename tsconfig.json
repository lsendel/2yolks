{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@cloudflare/workers-types",
      "@types/node"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@2yolks/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@2yolks/web/server": [
        "./packages/web/src/server.tsx"
      ]
    }
  },
  "include": [
    "packages/*/src"
  ]
}